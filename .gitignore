# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Datasets / large binaries (over GitHub 100MB limit)
*.hdf5
*.h5
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz

# Training run artifacts (auto-generated)
outputs/
lightning_logs/
wandb/
runs/
checkpoints/

# Media (auto-generated training visualizations)
*.mp4
*.mov
*.gif
# but keep README banner assets
!le-wm/assets/**
!phyworld/assets/**

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Logs
*.log
# but track run logs we keep as evidence
!artifacts/logs/*.log

# Large embedding caches under artifacts (regenerable)
artifacts/embeddings/*.npy
artifacts/embeddings/*.pt
